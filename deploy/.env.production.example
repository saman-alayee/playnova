# Copy to PlayNova/.env and fill in secrets before running deploy/setup-production.sh

APP_NAME=PlayNova
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOCALE=fa
APP_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playnova
DB_USERNAME=playnova
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sentry (create Laravel project at sentry.io)
SENTRY_LARAVEL_DSN=https://YOUR_KEY@oORG.ingest.sentry.io/PROJECT_ID
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=playnova@1.0.0

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# AvalAI (optional — can also be set in admin panel)
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_VISION_MODEL=gpt-4o
AVALAI_TIMEOUT=120
