# Production: use same-origin relative paths (works on domain or IP once DNS points to server)
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_BACKEND_URL=

# Local development:
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
# NUXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# NUXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oORG.ingest.sentry.io/FRONTEND_PROJECT_ID
# NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
