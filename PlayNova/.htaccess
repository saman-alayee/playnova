# Block direct web access to sensitive Laravel paths
<IfModule mod_authz_core.c>
    RedirectMatch 403 (?i)^/PlayNova/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$)
    RedirectMatch 403 (?i)^/PlayNova/\.env$
    RedirectMatch 403 (?i)^/PlayNova/composer\.(json|lock)$
</IfModule>