APP_NAME=PlayNova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000

# Production: Nuxt serves all UI; Laravel serves API only (/api/*).
# Set FRONTEND_URL to your Nuxt domain (e.g. https://playnova.ir).
# Configure reverse proxy: / → Nuxt, /api → Laravel.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playnova_local
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Production (see deploy/.env.production.example) ─────────────────
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# APP_DEBUG=false
# LOG_LEVEL=warning
#
# Sentry:
# SENTRY_LARAVEL_DSN=https://YOUR_KEY@oORG.ingest.sentry.io/PROJECT_ID
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=playnova@1.0.0
#
# Setup:
# 1. docker compose -f deploy/docker-compose.redis.yml up -d
# 2. bash deploy/setup-production.sh
# 3. Supervisor: deploy/supervisor-playnova-worker.conf
# 4. Health: GET /api/v1/health

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AvalAI — تشخیص برنده از اسکرین‌شات مسابقه (https://docs.avalai.ir)
# می‌توانید از پنل ادمین > تنظیمات هوش مصنوعی هم تنظیم کنید (اولویت با پنل است)
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_VISION_MODEL=gpt-4o
AVALAI_TIMEOUT=120
